AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below (gemini here).
# AGENT_LLM_PROVIDER=gemini
# AGENT_LLM_MODEL=gemini-2.5-pro   (Gemini default; flash used for chart/followups)

# Set the Gemini key (the single manual setup step):
AGENT_GEMINI_API_KEY=
AGENT_ANTHROPIC_API_KEY=

# Agent tuning
# AGENT_MAX_ATTEMPTS=4
# AGENT_HISTORY_TURNS=12

# Optional LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

PORT=8001
